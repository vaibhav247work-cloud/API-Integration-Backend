# Core runtime
SERVER_PORT=8080
SERVER_SHUTDOWN=graceful
SERVER_FORWARD_HEADERS_STRATEGY=framework
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s

# Database
DB_URL=jdbc:mysql://mysql.example.internal:3306/integration_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=integration_app
DB_PASSWORD=change-me
DB_MAX_POOL_SIZE=120
DB_MIN_IDLE=24

# API / CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://frontend.example.com
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_EXPOSED_HEADERS=Location
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE_SECONDS=3600

# Docs / health
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
MANAGEMENT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_HEALTH_SHOW_DETAILS=never

# Logging
ROOT_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
INTEGRATION_LOG_FILE=/app/logs/integration-engine.log
INTEGRATION_LOG_FILE_PATTERN=/app/logs/archive/integration-engine.%d{yyyy-MM-dd}.%i.log.gz

# Runtime roles and queue execution
INTEGRATION_RUNTIME_ROLES=API,SCHEDULER,WORKER
INTEGRATION_SCALABLE_MIGRATION_MODE=QUEUE
INTEGRATION_SCALABLE_JOB_STORE_VENDOR=MYSQL
INTEGRATION_SCALABLE_WORKER_BATCH_SIZE=64
INTEGRATION_SCALABLE_WORKER_MAX_CONCURRENCY=128
INTEGRATION_SCALABLE_WORKER_QUEUE_CAPACITY=2048
INTEGRATION_SCALABLE_WORKER_POLL_INTERVAL_MS=1000
INTEGRATION_SCALABLE_WORKER_LEASE_SECONDS=300
INTEGRATION_SCALABLE_WORKER_HEARTBEAT_SECONDS=15

# HTTP client / schedulers
INTEGRATION_EXECUTOR_POOL_SIZE=64
INTEGRATION_EXECUTOR_QUEUE_CAPACITY=1024
INTEGRATION_SCHEDULER_POOL_SIZE=16
INTEGRATION_QUARTZ_THREAD_COUNT=24
INTEGRATION_HTTP_CLIENT_MAX_CONNECTIONS=1000
INTEGRATION_HTTP_CLIENT_PENDING_ACQUIRE_MAX_COUNT=4000
INTEGRATION_HTTP_CLIENT_CONNECT_TIMEOUT_MS=5000
INTEGRATION_HTTP_CLIENT_RESPONSE_TIMEOUT_SECONDS=90

# Filesystem / storage
INTEGRATION_CSV_TEMP_DIR=/app/tmp/integration-engine
INTEGRATION_HTTP_API_UPLOAD_URL_TEMPLATE_MONTHLY=
INTEGRATION_HTTP_API_UPLOAD_URL_TEMPLATE_HOURLY=
INTEGRATION_HTTP_API_UPLOAD_URL_TEMPLATE_DAILY=
INTEGRATION_HTTP_API_ACCESS_TOKEN_HEADER_NAME=accessToken
INTEGRATION_HTTP_API_USER_ID_HEADER_NAME=userId
INTEGRATION_HTTP_API_TENANTS_JSON={}

# JVM
JAVA_OPTS=-Xms512m -Xmx1024m
