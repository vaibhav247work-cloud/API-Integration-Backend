        {
          "name": "Create Integration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data && data.id) {",
                  "        pm.collectionVariables.set('integrationId', String(data.id));",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
                "raw": "{\n  \"clientName\": \"Postman Demo Integration\",\n  \"brandCode\": \"CLIA\",\n  \"baseUrl\": \"https://client-a.example.com/api\",\n  \"enabled\": false,\n  \"schedulerMode\": \"QUEUE\",\n  \"scheduleConfig\": [\n    {\n      \"type\": \"DAILY\",\n      \"enabled\": true\n    },\n    {\n      \"type\": \"MONTHLY\",\n      \"enabled\": true\n    },\n    {\n      \"type\": \"HOURLY\",\n      \"enabled\": true,\n      \"intervalHours\": 1\n    }\n  ],\n  \"csvFileName\": \"postman_demo_orders.csv\",\n  \"outputDirectory\": \"output/postman-demo\",\n  \"maxRetries\": 2,\n  \"authConfig\": {\n    \"type\": \"API_KEY_HEADER\",\n    \"headerName\": \"X-API-KEY\",\n    \"headerValue\": \"replace-with-real-key\"\n  },\n  \"responseConfig\": {\n    \"recordPath\": \"$.data.orders\",\n    \"recordPathType\": \"JSON_PATH\",\n    \"duplicateHandling\": {\n      \"enabled\": true,\n      \"keyHeaders\": [\"ORDER_ID\"],\n      \"defaultAction\": \"KEEP_FIRST\",\n      \"fieldActions\": {\n        \"TOTAL_AMOUNT\": \"SUM\"\n      }\n    }\n  },\n  \"paginationConfig\": {\n    \"enabled\": true,\n    \"mode\": \"PAGE_NUMBER\",\n    \"startPage\": 1,\n    \"pageParam\": \"page\",\n    \"totalPagesPath\": \"$.meta.totalPages\",\n    \"totalPagesPathType\": \"JSON_PATH\"\n  },\n  \"storageConfig\": {\n    \"type\": \"LOCAL\",\n    \"localDirectory\": \"output/postman-demo\"\n  },\n  \"stepConfig\": [\n    {\n      \"orderIndex\": 1,\n      \"name\": \"fetch-orders\",\n      \"method\": \"GET\",\n      \"url\": \"/orders\",\n      \"queryParams\": {\n        \"page\": \"${page}\",\n        \"fromDate\": \"${windowStartDate}\",\n        \"toDate\": \"${windowEndDateExclusive}\"\n      },\n      \"requestFormat\": \"JSON\",\n      \"responseFormat\": \"JSON\",\n      \"paginate\": true,\n      \"dataStep\": true\n    }\n  ],\n  \"fieldMappings\": [\n    {\n      \"sortOrder\": 1,\n      \"mappingType\": \"SOURCE_PATH\",\n      \"sourcePath\": \"$.orderId\",\n      \"pathType\": \"JSON_PATH\",\n      \"targetHeader\": \"ORDER_ID\",\n      \"requiredFlag\": true\n    },\n    {\n      \"sortOrder\": 2,\n      \"mappingType\": \"CONSTANT\",\n      \"targetHeader\": \"STORE_ID\",\n      \"expression\": \"1\",\n      \"requiredFlag\": false\n    },\n    {\n      \"sortOrder\": 3,\n      \"mappingType\": \"EXPRESSION\",\n      \"targetHeader\": \"TOTAL_AMOUNT\",\n      \"expression\": \"num('$.net') + num('$.gross')\",\n      \"defaultValue\": \"0\",\n      \"requiredFlag\": false\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/integrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integrations"
              ]
            },
            "description": "Creates a new integration definition. On success, the response id is stored in the collection variable integrationId."
          },
          "response": []
        },
        {
          "name": "Update Integration",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
                "raw": "{\n  \"id\": {{integrationId}},\n  \"clientName\": \"Postman Demo Integration Updated\",\n  \"brandCode\": \"CLIA\",\n  \"baseUrl\": \"https://client-a.example.com/api\",\n  \"enabled\": false,\n  \"schedulerMode\": \"QUEUE\",\n  \"scheduleConfig\": [\n    {\n      \"type\": \"DAILY\",\n      \"enabled\": true\n    },\n    {\n      \"type\": \"MONTHLY\",\n      \"enabled\": false\n    },\n    {\n      \"type\": \"HOURLY\",\n      \"enabled\": true,\n      \"intervalHours\": 1\n    }\n  ],\n  \"csvFileName\": \"postman_demo_orders_v2.csv\",\n  \"outputDirectory\": \"output/postman-demo\",\n  \"maxRetries\": 3,\n  \"authConfig\": {\n    \"type\": \"API_KEY_HEADER\",\n    \"headerName\": \"X-API-KEY\",\n    \"headerValue\": \"replace-with-real-key\"\n  },\n  \"responseConfig\": {\n    \"recordPath\": \"$.data.orders\",\n    \"recordPathType\": \"JSON_PATH\",\n    \"duplicateHandling\": {\n      \"enabled\": true,\n      \"keyHeaders\": [\"ORDER_ID\"],\n      \"defaultAction\": \"KEEP_FIRST\",\n      \"fieldActions\": {\n        \"TOTAL_AMOUNT\": \"SUM\"\n      }\n    }\n  },\n  \"paginationConfig\": {\n    \"enabled\": true,\n    \"mode\": \"PAGE_NUMBER\",\n    \"startPage\": 1,\n    \"pageParam\": \"page\",\n    \"totalPagesPath\": \"$.meta.totalPages\",\n    \"totalPagesPathType\": \"JSON_PATH\"\n  },\n  \"storageConfig\": {\n    \"type\": \"LOCAL\",\n    \"localDirectory\": \"output/postman-demo\"\n  },\n  \"stepConfig\": [\n    {\n      \"orderIndex\": 1,\n      \"name\": \"fetch-orders\",\n      \"method\": \"GET\",\n      \"url\": \"/orders\",\n      \"queryParams\": {\n        \"page\": \"${page}\",\n        \"fromDate\": \"${windowStartDate}\",\n        \"toDate\": \"${windowEndDateExclusive}\"\n      },\n      \"requestFormat\": \"JSON\",\n      \"responseFormat\": \"JSON\",\n      \"paginate\": true,\n      \"dataStep\": true\n    }\n  ],\n  \"fieldMappings\": [\n    {\n      \"sortOrder\": 1,\n      \"mappingType\": \"SOURCE_PATH\",\n      \"sourcePath\": \"$.orderId\",\n      \"pathType\": \"JSON_PATH\",\n      \"targetHeader\": \"ORDER_ID\",\n      \"requiredFlag\": true\n    },\n    {\n      \"sortOrder\": 2,\n      \"mappingType\": \"CONSTANT\",\n      \"targetHeader\": \"STORE_ID\",\n      \"expression\": \"10\",\n      \"requiredFlag\": false\n    },\n    {\n      \"sortOrder\": 3,\n      \"mappingType\": \"EXPRESSION\",\n      \"targetHeader\": \"TOTAL_AMOUNT\",\n      \"expression\": \"num('$.net') + num('$.gross')\",\n      \"defaultValue\": \"0\",\n      \"requiredFlag\": false\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/integrations/{{integrationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integrations",
                "{{integrationId}}"
              ]
            },
            "description": "Full replacement update. Send the complete integration payload, including fieldMappings."
          },
          "response": []
        },
